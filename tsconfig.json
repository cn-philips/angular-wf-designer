{
  "compileOnSave": false,
  "compilerOptions": {
    "baseUrl": "src",
    "outDir": "./dist/out-tsc",
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "node",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "target": "es5",
    "module": "commonjs",
    "allowJs": true,
    "typeRoots": [
      "node_modules/@types",
      "src/typings.d.ts"
    ],
    "lib": [
      "es2017",
      "dom"
    ],
    "paths": {
      "@env": ["environments/environment"],
      "@shared/*": ["app/shared/*"],
      "@core/*": ["app/core/*"],
      "@pages/*": ["app/pages/*"],
      "@app/*": ["app/*"]
    }
  },
  "angularCompilerOptions": {
    "strictTemplates": true
  },
  "include": [
    "./src",
    "./node_modules/ng-autosize",
    "./src/typings.d.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
